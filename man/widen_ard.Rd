  normalize_ard(ard) |>
    widen_ard(cols = "ARM", rows = c(group = "variable"),
              cells = list(AGE = c("Mean (SD)" = "{mean:.1f} ({sd:.2f})"),
                           SEX = "{n} ({p:.1f\%})"),
              notes = FALSE)
